# Copy this file to .env and fill in real values. Never commit the actual .env file.
DB_PASSWORD=changeme
GEMINI_API_KEY=changeme

# Optional: override host port mappings if 8080/80 are already in use on the host
# (e.g. when Jenkins itself is running on port 8080).
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=8081
